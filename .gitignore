checkpoints/*.onnx
checkpoints/*.ckpt
checkpoints/*.safetensors
checkpoints/*.bin
checkpoints/*.h5
checkpoints/*.tflite
!checkpoints/*.json
!checkpoints/README.md
!checkpoints/.gitkeep

